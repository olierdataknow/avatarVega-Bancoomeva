# Contexto de build de la imagen. Lo que se excluya aqui no existe durante
# `npm run build`, asi que la imagen solo puede tomar frontend/.env.production.

# Env locales: nunca deben entrar al build de produccion
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.*.local

# Dependencias y artefactos que se regeneran dentro de la imagen
frontend/node_modules
frontend/dist
venv/
__pycache__/
*.py[cod]
app/__pycache__

# Notebooks de trabajo y metadatos del repo
app/temp.ipynb
.git
.gitignore
.dockerignore
.vscode
README.md
dev.sh
